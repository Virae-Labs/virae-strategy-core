{
  "name": "@viraeai/virae-strategy-core",
  "version": "0.6.0",
  "description": "Deterministic, side-effect-free prediction-market strategy decisions, execution policies, and replay contracts.",
  "keywords": [
    "prediction-markets",
    "trading-strategy",
    "polymarket",
    "typescript",
    "backtesting",
    "crypto"
  ],
  "license": "CPAL-1.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Virae-Labs/virae-strategy-core.git"
  },
  "homepage": "https://github.com/Virae-Labs/virae-strategy-core#readme",
  "bugs": {
    "url": "https://github.com/Virae-Labs/virae-strategy-core/issues"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "crypto-tail": [
        "dist/crypto-tail/index.d.ts"
      ],
      "pre-market": [
        "dist/pre-market/index.d.ts"
      ],
      "musk-tweet-count": [
        "dist/musk-tweet-count/index.d.ts"
      ],
      "weather-temperature": [
        "dist/weather-temperature/index.d.ts"
      ],
      "ev-snipe": [
        "dist/ev-snipe/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./crypto-tail": {
      "types": "./dist/crypto-tail/index.d.ts",
      "require": "./dist/crypto-tail/index.js",
      "default": "./dist/crypto-tail/index.js"
    },
    "./pre-market": {
      "types": "./dist/pre-market/index.d.ts",
      "require": "./dist/pre-market/index.js",
      "default": "./dist/pre-market/index.js"
    },
    "./musk-tweet-count": {
      "types": "./dist/musk-tweet-count/index.d.ts",
      "require": "./dist/musk-tweet-count/index.js",
      "default": "./dist/musk-tweet-count/index.js"
    },
    "./weather-temperature": {
      "types": "./dist/weather-temperature/index.d.ts",
      "require": "./dist/weather-temperature/index.js",
      "default": "./dist/weather-temperature/index.js"
    },
    "./ev-snipe": {
      "types": "./dist/ev-snipe/index.d.ts",
      "require": "./dist/ev-snipe/index.js",
      "default": "./dist/ev-snipe/index.js"
    },
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "prepare": "npm run build",
    "test": "jest --runInBand",
    "test:unit": "jest src --runInBand",
    "test:contract": "jest test/contract --runInBand",
    "test:integration": "jest test/integration --runInBand",
    "test:e2e": "npm run build && node scripts/e2e-consumer.mjs",
    "test:coverage": "jest --coverage --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example": "npm run build && node examples/decision-and-plan.cjs",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "prepack": "npm run clean && npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
